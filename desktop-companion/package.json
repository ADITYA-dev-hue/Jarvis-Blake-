{
  "name": "igris-desktop-companion",
  "version": "1.0.0",
  "description": "2.5D Local Windows Desktop AI Companion for IGRIS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "validate-assets": "python validate_assets.py",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "igris",
    "desktop-companion",
    "ai",
    "2.5d"
  ],
  "author": "Aditya Prakash",
  "license": "MIT",
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aditya.igris.companion",
    "productName": "IGRIS Companion",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "icon": "assets/igris/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "voice.js",
      "socket-client.js",
      "settings-store.js",
      "index.html",
      "styles.css",
      "package.json",
      "assets/**/*",
      "node_modules/**/*"
    ]
  }
}
