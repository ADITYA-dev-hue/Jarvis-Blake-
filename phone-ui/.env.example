# JARVIS Phone UI - Environment Configuration
# For local testing on the same Wi-Fi, replace localhost with your laptop's IPv4 address (found via `ipconfig`)
# Example: VITE_JARVIS_SERVER_URL=http://192.168.1.100:3000
VITE_JARVIS_SERVER_URL=http://localhost:3000

# Development authentication token for the Phone UI (must match JARVIS_PHONE_TOKEN on the server)
# Note: Never place permanent secrets or the laptop agent token in Vite frontend code!
VITE_JARVIS_PHONE_TOKEN=jarvis_phone_dev_token_884192
