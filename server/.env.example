# Server Port (Render sets this dynamically; defaults to 3000 for local dev)
PORT=3000

# Required authentication secret for laptop agent & commands (must match laptop-agent/.env)
JARVIS_AUTH_TOKEN=<set-this-in-render>

# Google Gemini API key for natural language command interpretation (server-side only)
GEMINI_API_KEY=<set-this-in-render>

# Gemini model (project default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Vercel frontend URL for phone client CORS (e.g. https://your-jarvis-phone.vercel.app)
JARVIS_FRONTEND_URL=<optional-vercel-frontend-url>

# Phone Client authentication token (defaults to dev token if unset)
JARVIS_PHONE_TOKEN=<optional-phone-token>

# Local phone client origin for local dev
JARVIS_PHONE_ORIGIN=http://localhost:5173

# Safe execution parameters
COMMAND_TIMEOUT_MS=5000
MAX_CONTEXT_MESSAGES=20
JARVIS_DEBUG=false
