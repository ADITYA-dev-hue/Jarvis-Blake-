# For local dev: http://localhost:3000
# For Render deployment: https://<render-service>.onrender.com
JARVIS_SERVER_URL=JARVIS_SERVER_URL=https://jarvis-blake.onrender.com

# Required authentication secret (MUST MATCH the JARVIS_AUTH_TOKEN set on Render)
JARVIS_AUTH_TOKEN=Vr3piqd9du7SHd16Zw9dNVMUHyuULnO63bZyk4vHSWM=

# Laptop agent identifier
JARVIS_AGENT_ID=LAPTOP-01

# Sandboxed workspace directory relative to project root
